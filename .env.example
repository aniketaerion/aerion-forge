AERION_REPOSITORY_PATH=.
AERION_WORKSPACE_PATH=./workspaces
AERION_REPORTS_PATH=./reports/latest
AERION_MEMORY_PATH=./memory
AERION_LOGS_PATH=./logs
AERION_LOG_LEVEL=INFO
AERION_OLLAMA_MODEL=qwen2.5-coder:7b
AERION_OLLAMA_BASE_URL=http://localhost:11434
AERION_COMMAND_TIMEOUT_SECONDS=120
AERION_INDEX_MAX_HASH_BYTES=10485760
AERION_INDEX_HASH_CHUNK_BYTES=65536
AERION_INDEX_MAX_FILES=250000
AERION_GRAPH_MAX_NODES=100000
AERION_GRAPH_MAX_EDGES=300000
AERION_GRAPH_MAX_MODULE_DEPTH=2
AERION_GRAPH_INCLUDE_DIRECTORY_NODES=true
AERION_CAPABILITY_REGISTRY_ENABLED=true
AERION_CAPABILITY_DISABLED_IDS=
AERION_CAPABILITY_INCLUDE_PLANNED=true
AERION_CAPABILITY_STRICT_VALIDATION=true
AERION_CAPABILITY_HISTORY_LIMIT=5
# Schema 1.0 contract; disabled capability IDs are comma-separated.
AERION_ALLOW_SHELL=false
AERION_ALLOW_DOCKER=false
AERION_ALLOW_DATABASE=false
